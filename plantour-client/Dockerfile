# Stage 1: Build the Angular app
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# Pass a build environment argument (defaults to production)
#ARG BUILD_ENV=
# Convert BUILD_ENV to lowercase to ensure it matches npm scripts (e.g. QA vs qa)
#RUN npm run build:$(echo ${BUILD_ENV} | tr '[:upper:]' '[:lower:]')
RUN npm run build:production

# Stage 2: Serve the SSR app with Node.js
FROM node:20-alpine
WORKDIR /app

# Copy the build output generated by Angular (includes browser and server output)
COPY --from=build /app/dist/plantour-app ./dist/plantour-app

# Expose the port that Angular's Express server defaults to
EXPOSE 4000

# Set the environment variable for the port and host (to accept external connections)
ENV PORT=4000
ENV HOST=0.0.0.0

# Start the Node.js server
CMD ["node", "dist/plantour-app/server/server.mjs"]