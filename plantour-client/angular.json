{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "plantour-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "skipTests": true,
          "style": "scss",
          "path": "src/app/components"
        },
        "@schematics/angular:service": {
          "skipTests": true,
          "path": "src/app/services"
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:module": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "prerender": false,
            "outputMode": "server",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "ssr": {
              "entry": "src/server.ts"
            },
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "fast-deep-equal"
            ]
          },
          "configurations": {
            "production": {
              "index": "src/index.html",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "40kB",
                  "maximumError": "80kB"
                }
              ],
              "outputHashing": "all",
              "assets": [
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "public/common"
                },
                {
                  "glob": "robots.txt",
                  "input": "public/production"
                }
              ]
            },
            "qa": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "index": {
                "input": "src/index.qa.html",
                "output": "index.html"
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.qa.ts"
                }
              ],
              "assets": [
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "public/common"
                },
                {
                  "glob": "robots.txt",
                  "input": "public/qa"
                }
              ]
            },
            "development": {
              "index": {
                "input": "src/index.qa.html",
                "output": "index.html"
              },
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "public/common"
                },
                {
                  "glob": "robots.txt",
                  "input": "public/qa"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "plantour-app:build:production"
            },
            "qa": {
              "buildTarget": "plantour-app:build:qa"
            },
            "development": {
              "buildTarget": "plantour-app:build:development"
            },
            "dev": {
              "buildTarget": "plantour-app:build:development"
            }
          },
          "defaultConfiguration": "dev"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ]
          }
        }
      }
    }
  }
}