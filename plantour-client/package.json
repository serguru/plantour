{
  "name": "plantour-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "check:help": "node ./scripts/check-help-content.mjs",
    "watch:help": "node ./scripts/check-help-content.mjs --watch",
    "start": "node ./scripts/run-help-aware-ng.mjs serve --host 0.0.0.0 --port 4203 --open",
    "serve:dev": "node ./scripts/run-help-aware-ng.mjs serve --configuration dev --host 0.0.0.0 --port 4203 --open",
    "serve:qa": "node ./scripts/run-help-aware-ng.mjs serve --configuration qa --host 0.0.0.0 --port 4203 --open",
    "serve:pred-prod": "node ./scripts/run-help-aware-ng.mjs serve --configuration pred-prod --host 0.0.0.0 --port 4203 --open",
    "build": "npm run check:help && ng build",
    "build:qa": "npm run check:help && ng build --configuration qa",
    "build:pred-prod": "npm run check:help && ng build --configuration pred-prod",
    "build:production": "npm run check:help && ng build --configuration production",
    "watch": "npm run check:help && ng build --watch --configuration development",
    "test": "npm run check:help && ng test",
    "start:ssr": "node dist/plantour-app/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.5",
    "@angular/common": "21.2.5",
    "@angular/compiler": "21.2.5",
    "@angular/core": "21.2.5",
    "@angular/forms": "21.2.5",
    "@angular/platform-browser": "21.2.5",
    "@angular/platform-server": "21.2.5",
    "@angular/router": "21.2.5",
    "@angular/ssr": "21.2.3",
    "@paddle/paddle-js": "^1.6.2",
    "@primeuix/themes": "2.0.3",
    "express": "^5.2.1",
    "fast-deep-equal": "^3.1.3",
    "flexsearch": "^0.8.212",
    "jwt-decode": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "21.2.3",
    "@angular/compiler-cli": "21.2.5",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.5.0",
    "jasmine-core": "~6.1.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "ng-packagr": "^21.2.1",
    "typescript": "~5.9.3"
  }
}
