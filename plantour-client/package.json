{
  "name": "plantour-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "check:help": "node ./scripts/check-help-content.mjs",
    "watch:help": "node ./scripts/check-help-content.mjs --watch",
    "m": "node ./scripts/run-help-aware-ng.mjs serve --host 0.0.0.0 --port 4203 --open",
    "serve:dev": "node ./scripts/run-help-aware-ng.mjs serve --configuration dev --host 0.0.0.0 --port 4203 --open",
    "serve:qa": "node ./scripts/run-help-aware-ng.mjs serve --configuration qa --host 0.0.0.0 --port 4203 --open",
    "serve:pred-prod": "node ./scripts/run-help-aware-ng.mjs serve --configuration pred-prod --host 0.0.0.0 --port 4203 --open",
    "build:qa": "npm run check:help && ng build --configuration qa",
    "build:pred-prod": "npm run check:help && ng build --configuration pred-prod",
    "build:production": "npm run check:help && ng build --configuration production",
    "watch": "npm run check:help && ng build --watch --configuration development",
    "test": "npm run check:help && ng test",
    "start:ssr": "node dist/plantour-app/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.5.1",
    "@angular/animations": "20.3.14",
    "@angular/common": "20.3.14",
    "@angular/compiler": "20.3.14",
    "@angular/core": "20.3.14",
    "@angular/forms": "20.3.14",
    "@angular/platform-browser": "20.3.14",
    "@angular/platform-server": "20.3.14",
    "@angular/router": "20.3.14",
    "@angular/ssr": "20.3.14",
    "@paddle/paddle-js": "^1.6.2",
    "@primeuix/themes": "2.0.1",
    "express": "^4.21.2",
    "fast-deep-equal": "^3.1.3",
    "jwt-decode": "^4.0.0",
    "primeicons": "7.0.0",
    "primeng": "20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.14",
    "@angular/cli": "20.3.14",
    "@angular/compiler-cli": "20.3.14",
    "@types/express": "^4.17.21",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.10.2",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "typescript": "~5.9.2"
  }
}
