{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "plantour-maintenance-server",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${workspaceFolder}/bin/Debug/net10.0/plantour_maintenance_server.dll",
			"args": [],
			"cwd": "${workspaceFolder}",
			"stopAtEntry": false,
			"justMyCode": true,
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"ASPNETCORE_URLS": "http://localhost:5238"
			},
			"serverReadyAction": {
				"action": "openExternally",
				"pattern": ".*",
				"uriFormat": "http://localhost:5238/users/health-check"
			},
			"logging": {
				"moduleLoad": false
			}
		}
	]
}