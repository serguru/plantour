using Microsoft.EntityFrameworkCore;
using plantour_server.DbModels;

namespace plantour_server.Repositories;

public class TripAssignRepository : BaseRepository
{
    private readonly DbSet<TripSharedThing> _dbSet;
    private readonly PlantourContext _context;

    public TripAssignRepository(PlantourContext context, IHttpContextAccessor httpContextAccessor) : base(httpContextAccessor)
    {
        _dbSet = context.Set<TripSharedThing>();
        _context = context;
    }

    public async Task<TripSharedThing?> GetByIdAsync(Guid tripId, Guid id)
    {
        if (CurrentUser == null)
        {
            return null;
        }

        if (CurrentUser.IsAdmin)
        {
            return await _dbSet
                .Include(x => x.AssignedBy)
                .Include(x => x.AssignedTo)
                .Include(x => x.AssignedThing)
                .FirstOrDefaultAsync(x =>
                    x.TripId == tripId &&
                    x.Id == id &&
                    x.Trip.UserId == CurrentUser.UserId &&
                    x.AssignedBy.AdminParticipant.AdminId == CurrentUser.UserId
                );
        }

        if (CurrentUser.IsParticipant)
        {
            return await _dbSet
                .Include(x => x.AssignedBy)
                .Include(x => x.AssignedTo)
                .Include(x => x.AssignedThing)
                .FirstOrDefaultAsync(x =>
                    x.TripId == tripId &&
                    x.Id == id &&
                    x.Trip.UserId == CurrentUser.AdminId &&
                    x.AssignedBy.AdminParticipant.AdminId == CurrentUser.AdminId
                );
        }

        return null;
    }

    public async Task<IEnumerable<TripSharedThing>> GetAllAsync(Guid tripId)
    {
        if (CurrentUser == null)
        {
            return Array.Empty<TripSharedThing>();
        }

        if (CurrentUser.IsAdmin)
        {
            return await _dbSet
                .Include(x => x.AssignedBy)
                .Include(x => x.AssignedTo)
                .Include(x => x.AssignedThing)
                .Where(x =>
                    x.TripId == tripId &&
                    x.Trip.UserId == CurrentUser.UserId &&
                    x.AssignedBy.AdminParticipant.AdminId == CurrentUser.UserId
                ).ToListAsync();
        }

        if (CurrentUser.IsParticipant)
        {
            return await _dbSet
                .Include(x => x.AssignedBy)
                .Include(x => x.AssignedTo)
                .Include(x => x.AssignedThing)
                .Where(x =>
                    x.TripId == tripId &&
                    x.Trip.UserId == CurrentUser.AdminId &&
                    x.AssignedBy.AdminParticipant.AdminId == CurrentUser.AdminId
                ).ToListAsync();
        }

        return Array.Empty<TripSharedThing>();
    }

    public async Task AddAsync(Guid tripId, TripSharedThing entity)
    {
        if (CurrentUser == null)
        {
            throw new InvalidOperationException("Access denied");
        }


        Trip? trip = null;

        if (CurrentUser.IsAdmin)
        {
            trip = await _context.Trips
                .FirstOrDefaultAsync(x =>
                    x.UserId == CurrentUser.UserId &&
                    );
        }

        if (CurrentUser.IsParticipant)
        {
            tripUser = await _context.TripUsers
                .FirstOrDefaultAsync(x =>
                    x.Trip.UserId == CurrentUser.AdminId &&
                    x.AdminParticipant.AdminId == CurrentUser.AdminId &&
                    x.AdminParticipant.ParticipantId == CurrentUser.UserId
                    );
        }

        if (tripUser == null)
        {
            throw new InvalidOperationException("Access denied");
        }

        entity.Id = Guid.NewGuid();
        entity.TripUserId = tripUser.Id;
        _context.TripUserThings.Add(entity);
        await _context.SaveChangesAsync();
    }

    public async Task UpdateAsync(TripSharedThing entity)
    {
        if (CurrentUser == null)
        {
            throw new InvalidOperationException("Access denied");
        }

        var existingEntity = await GetByIdAsync(entity.Id);
        if (existingEntity == null)
        {
            throw new InvalidOperationException("TripSharedThing not found");
        }

        _context.TripUserThings.Attach(entity);
        _context.Entry(entity).State = EntityState.Modified;
        await _context.SaveChangesAsync();
    }

    public async Task DeleteAsync(Guid id)
    {
        if (CurrentUser == null)
        {
            throw new InvalidOperationException("Access denied");
        }

        var entity = await GetByIdAsync(id);
        if (entity == null)
        {
            return;
        }

        _context.TripUserThings.Remove(entity);
        await _context.SaveChangesAsync();
    }
}
