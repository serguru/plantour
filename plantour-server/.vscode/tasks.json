{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/plantour-server.csproj",
				"/property:GenerateFullPaths=true",
				"/t:build",
				"/p:Configuration=Debug"
			],
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "build maintenance",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/../plantour-maintenance-server/plantour-maintenance-server.csproj",
				"/property:GenerateFullPaths=true",
				"/t:build",
				"/p:Configuration=Debug"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "watch",
			"command": "dotnet",
			"type": "process",
			"args": [
				"watch",
				"run",
				"--project",
				"${workspaceFolder}/plantour-server.csproj",
				"--environment",
				"Development"
			],
			"problemMatcher": "$msCompile",
			"runOptions": {
				"runOn": "folderOpen"
			},
			"isBackground": true
		},
		{
			"label": "watch",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"watch",
				"run",
				"--project",
				"${workspaceFolder}/plantour-server.csproj",
				"--environment",
				"Development"
			],
			"isBackground": true
		}
	]
}